# MQTT
MQTT_HOST=192.168.1.100
MQTT_PORT=1883
MQTT_USER=mqtt_nlp
MQTT_PASS=

# Redis
REDIS_URL=redis://localhost:6379

# SQLite
DB_PATH=./signal-room.db

# Rétention
RETENTION_DAYS=30

# Debounce Frigate (ms)
FRIGATE_DEBOUNCE_MS=300

# Préfixe custom du full_topic Tasmota (inclure le slash final si non vide)
# Laisser vide pour le format standard : tele/+/STATE, tele/+/SENSOR, stat/+/RESULT
# Exemple avec full_topic custom : home/chambre/lumiere/
TASMOTA_TOPIC_PREFIX=

# Ports
BACKEND_PORT=3001
FRONTEND_PORT=3000

# Frontend
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:3001/ws
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:3001
